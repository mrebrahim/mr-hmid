    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ {\n  \"patientId\": $json[0]?.id || $json.id,\n  \"patientName\": $json[0]?.name || $json.name,\n  \"phone\": $('Extract Phone & Message').item.json.phone,\n  \"message\": $('Extract Phone & Message').item.json.message,\n  \"messageId\": $('Extract Phone & Message').item.json.messageId,\n  \"instance\": $('Extract Phone & Message').item.json.instance\n} }}",
        "options": {}
      },
      "id": "merge-patient-data",
      "name": "Merge Patient Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1420, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT message, sender, created_at FROM conversations WHERE patient_id = '{{ $json.patientId }}' ORDER BY created_at DESC LIMIT 10"
      },
      "id": "query-history",
      "name": "Query Conversation History",
