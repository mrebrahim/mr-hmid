          },
          "conditions": [
            {
              "id": "patient-exists",
              "leftValue": "={{ $json.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-patient-exists",
      "name": "Patient Exists?",
