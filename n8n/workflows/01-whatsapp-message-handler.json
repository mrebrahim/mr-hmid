          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "patients",
          "mode": "list"
        },
        "filterType": "string",
        "filterString": "phone=eq.{{ $json.phone }}",
        "options": {}
      },
      "id": "query-patient",
      "name": "Query Patient",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [820, 300],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase"
