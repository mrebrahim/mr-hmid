{
  "name": "Appointment Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Hourly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  a.id as appointment_id,\n  p.id as patient_id,\n  p.name as patient_name,\n  p.phone as patient_phone,\n  s.name as service_name,\n  s.name_ar as service_name_ar,\n  a.appointment_date,\n  a.appointment_time\nFROM appointments a\nJOIN patients p ON a.patient_id = p.id\nJOIN services s ON a.service_id = s.id\nWHERE a.status = 'confirmed'\n  AND a.reminded = false\n  AND a.appointment_date = CURRENT_DATE + INTERVAL '1 day'"
      },
      "id": "query-appointments",
      "name": "Query Appointments for Reminder",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [420, 300],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches",
      "name": "Split Into Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [620, 300]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ {\n  \"message\": `تذكير: لديك موعد غداً 📅\n\n📅 ${$json.appointment_date}\n⏰ الساعة ${$json.appointment_time}\n🏥 ${$json.service_name_ar}\n\nهل ستحضر؟\nرد بـ \"نعم\" للتأكيد أو \"لا\" لإعادة الجدولة.`\n} }}",
        "options": {}
      },
      "id": "format-message",
      "name": "Format Reminder Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [820, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $('Split Into Batches').item.json.patient_phone }}"
            },
            {
              "name": "text",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "send-whatsapp",
      "name": "Send WhatsApp Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1020, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "EVOLUTION_CREDENTIAL_ID",
          "name": "Evolution API"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "appointments",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "reminded": true
          },
          "matchingColumns": [],
          "schema": []
        },
        "filterType": "string",
        "filterString": "id=eq.{{ $('Split Into Batches').item.json.appointment_id }}",
        "options": {}
      },
      "id": "update-reminded",
      "name": "Mark as Reminded",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1220, 300],
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase"
        }
      }
    },
    {
      "parameters": {},
      "id": "loop-back",
      "name": "Loop Back",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1420, 300]
    }
  ],
  "connections": {
    "Hourly Trigger": {
      "main": [
        [
          {
            "node": "Query Appointments for Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Appointments for Reminder": {
      "main": [
        [
          {
            "node": "Split Into Batches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Into Batches": {
      "main": [
        [
          {
