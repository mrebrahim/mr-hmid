# =================================
# Supabase Configuration
# =================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =================================
# OpenAI Configuration
# =================================
# For embeddings edge function and AI agent
OPENAI_API_KEY=sk-...

# =================================
# n8n Workflow Configuration
# =================================
# Base URL for n8n webhooks (without trailing slash)
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.app.n8n.cloud
# Webhook URL for forwarding WhatsApp messages to n8n
N8N_WHATSAPP_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/whatsapp-handler

# =================================
# App Configuration
# =================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
