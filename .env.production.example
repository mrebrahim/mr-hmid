# =================================
# Supabase Configuration
# =================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =================================
# OpenAI Configuration
# =================================
# For embeddings edge function and AI agent
OPENAI_API_KEY=sk-...

# =================================
# n8n Workflow Configuration
# =================================
# Webhook URL for forwarding WhatsApp messages to n8n
N8N_WHATSAPP_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/whatsapp-handler

# =================================
# Evolution API Configuration
# =================================
# Used by n8n workflows for WhatsApp Business integration
EVOLUTION_API_URL=https://your-evolution-api.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=your-instance-name

# =================================
# App Configuration
# =================================
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_DEFAULT_LOCALE=ar
